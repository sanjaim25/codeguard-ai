{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {"type": "string", "maxLength": 4000},
    "findings": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "description", "filePath", "line", "severity", "category", "suggestedFix", "confidence", "explanation"],
        "properties": {
          "title": {"type": "string", "maxLength": 200},
          "description": {"type": "string", "maxLength": 4000},
          "filePath": {"type": ["string", "null"], "maxLength": 500},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "category": {"type": "string", "enum": ["BUG", "SECURITY", "NULL_HANDLING", "ERROR_HANDLING", "RESOURCE_LEAK", "MAINTAINABILITY", "PERFORMANCE", "CONCURRENCY", "INPUT_VALIDATION"]},
          "suggestedFix": {"type": "string", "maxLength": 4000},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string", "maxLength": 4000}
        }
      }
    }
  }
}
