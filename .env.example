# Docker defaults to a clearly labeled local demo. Never expose demo mode publicly.
DEMO_MODE=true
COOKIE_SECURE=false
DATABASE_PASSWORD=codeguard-local
RABBITMQ_PASSWORD=codeguard-local
GITHUB_CLIENT_ID=
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Compose mounts ./secrets/github-app.pem (PKCS8 RSA private key).
GITHUB_PRIVATE_KEY_PATH=
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MAX_DIFF_CHARS=40000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_INPUT_TOKENS=64000
AI_CONCURRENCY=2
AI_MAX_COST_USD=0.05
# Operator-supplied estimates; verify against your provider's actual pricing.
AI_INPUT_PER_MILLION=0.40
AI_OUTPUT_PER_MILLION=1.60
REVIEW_CONCURRENCY=2
